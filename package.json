{
  "name": "mini-waf",
  "version": "1.2.0",
  "description": "Minimalistic Web Application Firewall for Node.js — declarative rules, immutable engine, Express/Fastify/NestJS adapters.",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json",
    "./express": {
      "import": {
        "types": "./dist/esm/express.d.ts",
        "default": "./dist/esm/express.js"
      },
      "require": {
        "types": "./dist/cjs/express.d.ts",
        "default": "./dist/cjs/express.js"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/esm/fastify.d.ts",
        "default": "./dist/esm/fastify.js"
      },
      "require": {
        "types": "./dist/cjs/fastify.d.ts",
        "default": "./dist/cjs/fastify.js"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/esm/nestjs.d.ts",
        "default": "./dist/esm/nestjs.js"
      },
      "require": {
        "types": "./dist/cjs/nestjs.d.ts",
        "default": "./dist/cjs/nestjs.js"
      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/esm/adapters/index.d.ts",
        "default": "./dist/esm/adapters/index.js"
      },
      "require": {
        "types": "./dist/cjs/adapters/index.d.ts",
        "default": "./dist/cjs/adapters/index.js"
      }
    },
    "./presets": {
      "import": {
        "types": "./dist/esm/presets/index.d.ts",
        "default": "./dist/esm/presets/index.js"
      },
      "require": {
        "types": "./dist/cjs/presets/index.d.ts",
        "default": "./dist/cjs/presets/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.cjs.json && tsc-alias -p tsconfig.build.cjs.json && tsc -p tsconfig.build.esm.json && tsc-alias -p tsconfig.build.esm.json --resolve-full-paths && node scripts/mark-dist-types.mjs",
    "clean": "rm -rf dist",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "bench": "npm run build && node benchmarks/run.mjs",
    "bench:http": "npm run build && node benchmarks/http.mjs",
    "bench:compare": "npm run build && node benchmarks/compare.mjs",
    "integration": "npm run build && npm install --prefix integration && npm run integration --prefix integration",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MurylloEx/Mini-WAF.git"
  },
  "keywords": [
    "waf",
    "firewall",
    "security",
    "express",
    "fastify",
    "nestjs",
    "middleware",
    "adapter",
    "typescript"
  ],
  "author": "Muryllo Pimenta de Oliveira",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9",
    "@nestjs/core": ">=9",
    "express": ">=4",
    "fastify": ">=4"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "express": "^5.1.0",
    "fastify": "^5.2.1",
    "tsc-alias": "^1.9.5",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.1"
  },
  "module": "./dist/esm/index.js",
  "typesVersions": {
    "*": {
      "express": [
        "./dist/cjs/express.d.ts"
      ],
      "fastify": [
        "./dist/cjs/fastify.d.ts"
      ],
      "nestjs": [
        "./dist/cjs/nestjs.d.ts"
      ],
      "adapters": [
        "./dist/cjs/adapters/index.d.ts"
      ],
      "presets": [
        "./dist/cjs/presets/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "homepage": "https://murylloex.github.io/Mini-WAF/",
  "bugs": {
    "url": "https://github.com/MurylloEx/Mini-WAF/issues"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/mini-waf"
  }
}
